# Copy this file to .env.local (which is gitignored) and fill in your key.
# .env.local is never committed — .env* is in .gitignore.

# Free API key from https://twelvedata.com/pricing (Basic/free plan).
# No credit card needed. Free tier: 800 requests/day, 8 requests/minute,
# covers US stock quotes, company profile, key statistics, and historical
# daily prices — everything the Company Profile module needs.
TWELVE_DATA_API_KEY=your_key_here

# Paid API key from https://console.anthropic.com — only needed for the
# "Pro" AI report-grading feature (unlocked on the site with the code
# "bloombruh"). Unlike every other data source in this project, this one
# is NOT free: each grading request costs a small amount on your own
# Anthropic account. Everything else on the site works with no key here.
ANTHROPIC_API_KEY=your_key_here

# Free API key from https://eodhd.com — only needed for Hong Kong Stock
# Exchange (HKEX) coverage on the Company Profile page (tickers like
# "0700.HK"). Twelve Data's plan above doesn't include HKEX (confirmed by
# testing — it returns a paid-plan-only error), and EODHD was the free
# alternative found that actually does. Free tier: 20 requests/day + a
# 500-call welcome bonus. Every other exchange on this site works without
# this key at all.
EODHD_API_KEY=your_key_here
